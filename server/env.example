DATABASE_URL=postgresql://postgres:password@localhost:5432/tabpro
PORT=3001

# Google OAuth - get from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# JWT - generate a strong random string
JWT_SECRET=your_super_secret_jwt_key_change_this

# Client URL
CLIENT_URL=http://localhost:5173

# VAPID Keys for Push Notifications - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@tabpro.app

# Public URL of this API (used by `yarn pawapay:check` to verify callback URLs)
PUBLIC_API_URL=http://localhost:3001

# pawaPay v2 — Mobile Money (MTN MoMo + Airtel Money, Rwanda). https://docs.pawapay.io/v2
# PAWAPAY_ENV: sandbox (api.sandbox.pawapay.io) or production (api.pawapay.io).
# The token comes from the pawaPay dashboard; sandbox and production tokens differ.
# In the dashboard, set the callback URLs to:
#   Deposits: <PUBLIC_API_URL>/api/tabpayment/callback/deposit
#   Payouts:  <PUBLIC_API_URL>/api/tabpayment/callback/payout
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
# TabPro's service fee on in-app payments, in percent
TABPRO_CUT_PERCENT=8
