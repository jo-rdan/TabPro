DATABASE_URL=postgresql://postgres:password@localhost:5432/tabpro
PORT=3001

# Google OAuth - get from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# JWT - generate a strong random string
JWT_SECRET=your_super_secret_jwt_key_change_this

# Client URL
CLIENT_URL=http://localhost:5173

# VAPID Keys for Push Notifications - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@tabpro.app

# Flutterwave (billing) - Phase 6
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
