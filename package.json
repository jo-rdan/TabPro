{
  "name": "tabpro",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "resolutions": {
    "@types/express-serve-static-core": "4.17.41",
    "@types/express": "4.17.21"
  },
  "scripts": {
    "dev": "concurrently \"yarn workspace @tabpro/server dev\" \"yarn workspace @tabpro/client dev\"",
    "build": "yarn workspace @tabpro/server build && yarn workspace @tabpro/client build",
    "db:generate": "yarn workspace @tabpro/server db:generate",
    "db:migrate": "yarn workspace @tabpro/server db:migrate",
    "db:studio": "yarn workspace @tabpro/server db:studio",
    "pawapay:check": "yarn workspace @tabpro/server pawapay:check",
    "test:e2e:local": "bash tests/e2e/local.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
