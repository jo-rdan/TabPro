{
  "name": "tabpro",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "resolutions": {
    "@types/express-serve-static-core": "4.17.41"
  },
  "scripts": {
    "dev": "concurrently \"yarn workspace server dev\" \"yarn workspace client dev\"",
